{
  "name": "webmcp-action-assurance-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dom": "vitest run --project dom",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:native-webmcp": "npm run build",
    "test:native-webmcp": "playwright test --config playwright.native.config.ts",
    "test:staging-target": "npm --prefix workers/refund-staging-target test",
    "check:staging-target": "npm --prefix workers/refund-staging-target run check",
    "check:public": "node scripts/check-public-boundary.mjs",
    "ci:check": "npm run check:public && npm run type-check && npm run test:run && npm run check:staging-target && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
