{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "action-check-refund-staging-target",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "REFUND_RUNS",
        "class_name": "RefundRunState"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "RESET_RATE_LIMITER",
      "namespace_id": "20442001",
      "simple": {
        "limit": 20,
        "period": 10
      }
    }
  ],
  "exports": {
    "RefundRunState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173",
    "CAPABILITY_TTL_SECONDS": "900",
    "DEPLOYMENT_ID": "local-development"
  },
  "env": {
    "production": {
      "durable_objects": {
        "bindings": [
          {
            "name": "REFUND_RUNS",
            "class_name": "RefundRunState"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RESET_RATE_LIMITER",
          "namespace_id": "90901001",
          "simple": {
            "limit": 20,
            "period": 10
          }
        }
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://action-check-webmcp.vercel.app",
        "CAPABILITY_TTL_SECONDS": "900",
        "DEPLOYMENT_ID": "action-check-2026-09-01-r1"
      }
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
