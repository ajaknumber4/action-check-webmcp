{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.native.config.ts",
    "scripts/**/*.mjs",
    "server/**/*.ts",
    "src/integrations/external-target-staging/**/*.ts",
    "tests/**/*.server.test.ts"
  ]
}
